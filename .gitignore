# macOS
.DS_Store

# Zugangsdaten – gehören nie ins Repo (Instagram/Telegram-Tokens)
*.local.json

# Marketing-Werkzeuge: Abhängigkeiten und generierte Medien
marketing/**/node_modules
marketing/**/out/

# Alte Arbeitskopien
marketing Kopie/
marketing Kopie.zip

# Python-Bytecode der Marketing-Skripte
marketing/__pycache__/

# Ausgabe von xcodebuild -target (ohne -scheme)
build/
marketing/flyer/out/

# E-Mail-Signatur: enthält Anschrift und Telefonnummer, Repository ist öffentlich
marketing/signatur/

# Outreach-Kampagne Einsteiger-Plakat: Ansprechpartner der Clubs, Mails mit Absendername
marketing/outreach/einsteiger-plakat/

# Lizenzmusik der Reels und Filme – darf nicht öffentlich weitergegeben werden
marketing/reel-*/material/*.mp3
marketing/onetake-*/music/

# onetake-Filme: Entwürfe, Tonspuren und Logs entstehen neu aus Komposition und Ton-Skript
marketing/onetake-*/draft*.mp4
marketing/onetake-*/draft*.render.json
marketing/onetake-*/*.wav
marketing/onetake-*/*.log
