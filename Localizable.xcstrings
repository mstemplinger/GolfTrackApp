    "Regelfrage am Wasserhindernis? Taktik für ein schwieriges Loch? Der Caddy antwortet per Sprache – mitten auf der Runde." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otázka k pravidlům u vodní překážky? Taktika na těžkou jamku? Caddy odpoví hlasem – uprostřed kola."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A rules question at the water hazard? Strategy for a tricky hole? The Caddy answers by voice – right in the middle of your round."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Duda de reglas en el agua? ¿Táctica para un hoyo difícil? El Caddy te responde por voz, en plena vuelta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une question de règle près de l'eau ? Une tactique pour un trou difficile ? Le Caddy répond à voix haute, en pleine partie."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dubbio sulle regole vicino all'acqua? Tattica per una buca difficile? Il Caddy risponde a voce, nel pieno del giro."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pytanie o reguły przy przeszkodzie wodnej? Taktyka na trudny dołek? Caddy odpowiada głosowo – w środku rundy."
          }
        }
      }
    },
