    "So viele gute Stunden am Stück braucht es, damit ein Zeitraum als Golf-Fenster angezeigt wird. Neun Loch dauern etwa 2 Stunden, 18 Loch etwa 4." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tolik dobrých hodin v kuse je potřeba, aby se období zobrazilo jako golfové okno. Devět jamek trvá asi 2 hodiny, 18 jamek asi 4."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This many good hours in a row are needed for a period to show up as a golf window. Nine holes take about 2 hours, 18 holes about 4."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se necesitan tantas horas buenas seguidas para que un periodo aparezca como ventana para golf. Nueve hoyos duran unas 2 horas, 18 hoyos unas 4."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il faut autant d'heures favorables d'affilée pour qu'une période s'affiche comme créneau golf. Neuf trous durent environ 2 heures, 18 trous environ 4."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Servono tante ore buone di fila perché un periodo venga mostrato come finestra per il golf. Nove buche durano circa 2 ore, 18 buche circa 4."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tyle dobrych godzin z rzędu potrzeba, aby okres był pokazany jako okno golfowe. Dziewięć dołków trwa około 2 godzin, 18 dołków około 4."
          }
        }
      }
    },
    "Sobald du ein Minigolf-Spiel beendest, landet es hier." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jakmile dohraješ minigolfovou hru, objeví se tady."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
