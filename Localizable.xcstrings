    "Die abgeleitete Länge passt nicht zur Scorecard – hier steckt wahrscheinlich ein GPS-Ausreißer oder ein falsch zugeordnetes Loch drin." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odvozená délka neodpovídá scorekartě – pravděpodobně je tu odlehlý bod GPS nebo špatně přiřazená jamka."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The derived length does not match the scorecard – there is probably a GPS outlier or a wrongly assigned hole in here."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La longitud deducida no coincide con la scorecard: probablemente haya un valor GPS atípico o un hoyo mal asignado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La longueur déduite ne correspond pas à la carte de score : il y a probablement une valeur GPS aberrante ou un trou mal attribué."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La lunghezza dedotta non corrisponde allo scorecard: probabilmente c'è un valore GPS anomalo o una buca assegnata in modo errato."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wyznaczona długość nie pasuje do karty wyników – prawdopodobnie jest tu błędny punkt GPS lub źle przypisany dołek."
          }
        }
      }
    },
    "Die aktuellen Golfregeln gelten seit dem 1. Januar 2023. Lokale Platzregeln können einzelne Punkte abweichen." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktuální pravidla golfu platí od 1. ledna 2023. Místní pravidla hřiště se mohou v jednotlivých bodech lišit."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The current golf rules have been in effect since January 1, 2023. Local course rules may differ on individual points."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las reglas de golf actuales están en vigor desde el 1 de enero de 2023. Las reglas locales del campo pueden diferir en algunos puntos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les règles de golf actuelles sont en vigueur depuis le 1er janvier 2023. Les règles locales du parcours peuvent différer sur certains points."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le regole del golf attuali sono in vigore dal 1° gennaio 2023. Le regole locali del campo possono differire su singoli punti."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obecne reguły golfa obowiązują od 1 stycznia 2023 r. Lokalne reguły pola mogą różnić się w poszczególnych punktach."
          }
        }
      }
    },
    "Die App lernt deinen Platz" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikace se učí tvé hřiště"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The app learns your course"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La app aprende tu campo"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'app apprend ton parcours"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'app impara il tuo campo"
