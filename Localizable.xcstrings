    "Noch wenige Runden, der Korridor kann daneben liegen." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zatím málo kol, koridor může být mimo."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only a few rounds so far, the corridor can be off."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todavía pocas vueltas, el corredor puede estar desplazado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encore peu de parties, le couloir peut être décalé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ancora pochi giri, il corridoio può essere spostato."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dopiero kilka rund, korytarz może być niedokładny."
          }
        }
      }
    },
    "Noch wenige Runden. Der Korridor kann daneben liegen, vor allem an Doglegs." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zatím málo kol. Koridor může být mimo, hlavně u doglegů."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only a few rounds so far. The corridor can be off, especially at doglegs."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todavía pocas vueltas. El corredor puede estar desplazado, sobre todo en los doglegs."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encore peu de parties. Le couloir peut être décalé, surtout dans les doglegs."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ancora pochi giri. Il corridoio può essere spostato, soprattutto nei dogleg."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dopiero kilka rund. Korytarz może być niedokładny, zwłaszcza na doglegach."
          }
        }
      }
    },
    "Notizen" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poznámky"
          }
        },
        "de" : {
