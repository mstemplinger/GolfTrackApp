    "Dein Anspiel hat Potenzial. Gezielte Schlagformen bringen dich näher an die Fahne." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tvá přihrávka na green má potenciál. Cílené tvary ran tě dostanou blíž k vlajce."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Anspiel hat Potenzial. Gezielte Schlagformen bringen dich näher an die Fahne."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your approach play has potential. Shaped shots bring you closer to the pin."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu approach tiene potencial. Curvar el golpe a propósito te acerca a la bandera."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ton jeu d'approche a du potentiel. Des effets maîtrisés te rapprochent du drapeau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo avvicinamento ha potenziale. Colpi lavorati ti portano più vicino alla bandiera."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twoje podejścia mają potencjał. Celowo kształtowane uderzenia przybliżą cię do flagi."
          }
        }
      }
    },
    "DEIN DURCHSCHNITT" : {
      "localizations" : {
