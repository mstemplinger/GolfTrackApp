    "Wettkämpfe zählen immer über die ganze Runde – auch wenn du sie erst jetzt einschaltest." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soutěže se vždy počítají za celé kolo – i když je zapneš až teď."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wettkämpfe zählen immer über die ganze Runde – auch wenn du sie erst jetzt einschaltest."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contests always count for the whole round – even if you switch them on right now."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los retos cuentan siempre para toda la vuelta, aunque los actives ahora mismo."
          }
        },
        "fr" : {
