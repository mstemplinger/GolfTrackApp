    "2 gegen 2: Pro Team zählt der bessere Score. Die Teams spielen Loch für Loch gegeneinander (Matchplay)." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2 proti 2: v každém týmu se počítá lepší skóre. Týmy hrají proti sobě jamku po jamce (jamková hra)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2 vs 2: the better score counts for each team. The teams play against each other hole by hole (match play)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2 contra 2: por equipo cuenta el mejor resultado. Los equipos juegan hoyo a hoyo entre sí (match play)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2 contre 2 : le meilleur score compte pour chaque équipe. Les équipes s’affrontent trou par trou (match play)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2 contro 2: per ogni squadra conta il punteggio migliore. Le squadre si sfidano buca per buca (match play)."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2 na 2: w każdej drużynie liczy się lepszy wynik. Drużyny grają przeciwko sobie dołek po dołku (match play)."
