            "value" : "Potem %1$@ / %2$@, możesz zrezygnować w każdej chwili."
          }
        }
      }
    },
    "Das Ergebnis wird nicht gespeichert." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Výsledek se neuloží."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Ergebnis wird nicht gespeichert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The result will not be saved."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El resultado no se guardará."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le résultat ne sera pas enregistré."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il risultato non verrà salvato."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wynik nie zostanie zapisany."
          }
        }
      }
    },
    "Das Löschen entfernt nur die Laufspuren. Runden, Scores und bereits übernommene Loch-Positionen bleiben erhalten." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Smazání odstraní jen trasy. Kola, skóre a již převzaté polohy jamek zůstanou zachovány."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deleting only removes the walking paths. Rounds, scores and hole positions you have already applied are kept."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al eliminar solo se borran los trazados. Las vueltas, los scores y las posiciones de hoyo ya aplicadas se conservan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La suppression ne retire que les tracés. Les parties, les scores et les positions de trous déjà appliquées sont conservés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'eliminazione rimuove solo i tracciati. Giri, score e posizioni delle buche già applicate vengono conservati."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usunięcie dotyczy tylko tras. Rundy, wyniki i już zastosowane pozycje dołków zostaną zachowane."
          }
        }
      }
    },
    "Das Regelwerk mit Diagrammen – zum Nachschlagen beim Lernen" : {
