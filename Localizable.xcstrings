    "Jederzeit überspringbar" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kdykoli přeskočitelné"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skip anytime"
          }
