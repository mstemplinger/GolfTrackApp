        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A round without any obvious weak spot. This lesson helps you hold that level."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vuelta sin puntos débiles claros. Esta lección te ayuda a mantener el nivel."
