    "Erinnert dich am nächsten Morgen an eine unfertige Runde" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Druhý den ráno ti připomene nedokončené kolo"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reminds you the next morning about an unfinished round"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te recuerda a la mañana siguiente una vuelta sin terminar"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te rappelle le lendemain matin une partie inachevée"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ti ricorda il mattino seguente di un giro incompiuto"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przypomina ci następnego ranka o niedokończonej rundzie"
          }
        }
      }
    },
    "Erinnert dich während einer Runde regelmäßig ans Trinken" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Během kola ti pravidelně připomene, abys pil"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regularly reminds you to drink during a round"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te recuerda beber con regularidad durante la vuelta"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te rappelle régulièrement de boire pendant la partie"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ti ricorda regolarmente di bere durante il giro"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regularnie przypomina o piciu podczas rundy"
          }
        }
      }
    },
    "Erinnert dich während einer Runde, wenn du längere Zeit nichts eingetragen hast" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Připomene se ti během kola, když delší dobu nic nezapíšeš"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reminds you during a round if you haven't entered anything for a while"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te recuerda durante una vuelta si no introduces nada durante un rato"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te rappelle pendant une partie si tu n'as rien saisi depuis un moment"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ti ricorda durante un giro se non inserisci nulla per un po'"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przypomina ci w trakcie rundy, jeśli dłużej nic nie wpisałeś"
          }
        }
      }
    },
