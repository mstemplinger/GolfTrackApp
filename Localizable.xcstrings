    },
    "Warte kurz, bis dein Standort gefunden ist, und versuch es dann noch einmal." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chvíli počkej, než se najde tvá poloha, a zkus to znovu."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wait a moment until your location is found, then try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Espera un momento hasta que se encuentre tu ubicación y vuelve a intentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attends un instant que ta position soit trouvée, puis réessaie."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attendi un attimo finché la tua posizione viene trovata, poi riprova."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poczekaj chwilę, aż twoja lokalizacja zostanie ustalona, i spróbuj ponownie."
          }
        }
      }
    },
    "Warum sehe ich das?" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proč to vidím?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
