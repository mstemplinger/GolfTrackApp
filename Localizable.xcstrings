    "Platz wählen oder den QR-Code am Platz scannen, eine von 18 Spielformen aussuchen, Bag und Mitspieler dazu – fertig." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyber hřiště nebo naskenuj QR kód na hřišti, zvol jeden z 18 herních formátů, přidej bag a spoluhráče – hotovo."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pick a course or scan the QR code at the club, choose one of 18 game formats, add your bag and playing partners – done."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige un campo o escanea el código QR del club, selecciona una de 18 modalidades, añade tu bolsa y compañeros: listo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisis un parcours ou scanne le QR code sur place, sélectionne une des 18 formules, ajoute ton sac et tes partenaires – c'est parti."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli un campo o scansiona il QR code al circolo, una delle 18 formule di gioco, aggiungi sacca e compagni – fatto."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wybierz pole albo zeskanuj kod QR na polu, wybierz jeden z 18 formatów gry, dodaj torbę i współgraczy – gotowe."
          }
        }
      }
    },
