    "Einzelne Löcher kosten dir zu viele Schläge. Gleichmäßiges Tempo hilft bei Drucksituationen." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jednotlivé jamky tě stojí příliš mnoho ran. Rovnoměrné tempo pomáhá pod tlakem."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einzelne Löcher kosten dir zu viele Schläge. Gleichmäßiges Tempo hilft bei Drucksituationen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Single holes cost you too many strokes. A steady tempo helps under pressure."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Algunos hoyos te cuestan demasiados golpes. Un tempo constante ayuda bajo presión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Certains trous te coûtent trop de coups. Un tempo régulier aide sous pression."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alcune buche ti costano troppi colpi. Un tempo costante aiuta sotto pressione."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pojedyncze dołki kosztują cię zbyt wiele uderzeń. Równe tempo pomaga w sytuacjach pod presją."
          }
        }
      }
    },
