    "Unten auf „Weiter“ geht es zur nächsten Bahn. Der Stand wird automatisch gesichert, auch wenn du das Handy weglegst." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tlačítkem „Pokračovat“ dole přejdeš na další dráhu. Stav se ukládá automaticky, i když telefon odložíš."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Continue” at the bottom takes you to the next hole. The score is saved automatically, even if you put the phone away."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con «Continuar» abajo pasas a la siguiente pista. El marcador se guarda automáticamente, aunque dejes el móvil."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En bas, « Continuer » mène à la piste suivante. Le score est enregistré automatiquement, même si tu poses le téléphone."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In basso «Avanti» porta alla pista successiva. Il punteggio viene salvato automaticamente, anche se posi il telefono."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na dole przyciskiem „Dalej” przejdziesz do następnego toru. Stan gry zapisuje się automatycznie, nawet jeśli odłożysz telefon."
          }
        }
      }
    },
    "Unten in der Leiste erreichst du alle Bereiche. Das Tutorial findest du jederzeit wieder unter Profil → Tutorial neu starten." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lišta dole tě dovede do všech sekcí. Návod najdeš kdykoli znovu v Profil → Spustit návod znovu."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The bar at the bottom takes you to every section. You can find the tutorial again anytime under Profile → Restart Tutorial."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La barra inferior te lleva a todas las secciones. Puedes volver a ver el tutorial en Perfil → Reiniciar el tutorial."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La barre du bas mène à toutes les sections. Tu retrouves le tutoriel à tout moment sous Profil → Redémarrer le tutoriel."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La barra in basso porta a tutte le sezioni. Il tutorial lo ritrovi in qualsiasi momento in Profilo → Riavvia tutorial."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pasek na dole prowadzi do wszystkich sekcji. Samouczek znajdziesz w każdej chwili w Profil → Uruchom samouczek ponownie."
          }
        }
      }
    },
