    "Handicap-Verlauf, Bestleistungen und dein Bag mit den echten Weiten jedes Schlägers. Die Mitgliedskarte hast du ebenfalls immer dabei." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vývoj handicapu, osobní rekordy a tvůj bag se skutečnými délkami každé hole. Členskou kartu máš také vždy u sebe."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Handicap history, personal bests and your bag with the real distance of every club. Your membership card is always with you, too."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Evolución del hándicap, mejores marcas y tu bolsa con la distancia real de cada palo. Tu tarjeta de socio también va siempre contigo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Évolution du handicap, records et ton sac avec la distance réelle de chaque club. Ta carte de membre est toujours avec toi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Andamento handicap, record personali e la tua sacca con la distanza reale di ogni mazza. Anche la tessera del circolo è sempre con te."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Historia handicapu, rekordy i twoja torba z rzeczywistymi odległościami każdego kija. Kartę członkowską też masz zawsze przy sobie."
          }
        }
      }
    },
