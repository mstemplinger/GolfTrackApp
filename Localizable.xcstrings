    "Wie Better Ball, aber gewertet nach Stableford-Punkten. Die höheren Punkte pro Loch zählen für das Team." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jako Better Ball, ale hodnoceno body Stableford. Vyšší body na jamce se počítají pro tým."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Like Better Ball, but scored with Stableford points. The higher points on each hole count for the team."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Como Better Ball, pero con puntuación Stableford. En cada hoyo cuentan los puntos más altos para el equipo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comme le Better Ball, mais avec un décompte Stableford. Les points les plus élevés par trou comptent pour l’équipe."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Come il Better Ball, ma con punteggio Stableford. Su ogni buca contano i punti più alti per la squadra."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jak Better Ball, ale z punktacją Stableford. Wyższe punkty na dołku liczą się dla drużyny."
          }
        }
      }
    },
    "Wie das funktioniert" : {
      "localizations" : {
