    "Namen eingeben oder erneut drücken, um ohne Namen zu starten." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zadej jména nebo stiskni znovu a začni bez jmen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Namen eingeben oder erneut drücken, um ohne Namen zu starten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enter names or press again to start without names."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Introduce los nombres o pulsa de nuevo para empezar sin nombres."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saisis les noms ou appuie de nouveau pour commencer sans noms."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inserisci i nomi o premi di nuovo per iniziare senza nomi."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wpisz imiona lub naciśnij ponownie, aby zacząć bez imion."
          }
        }
      }
    },
    "Namen sind optional – leer lassen geht auch." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jména jsou volitelná – můžeš je nechat prázdná."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Names are optional – leaving them empty works too."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los nombres son opcionales: puedes dejarlos vacíos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les noms sont facultatifs – tu peux les laisser vides."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I nomi sono facoltativi: puoi lasciarli vuoti."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imiona są opcjonalne – można je zostawić puste."
          }
        }
      }
    },
    "Nebenwertungen zusätzlich zur Schlagzahl – jede hat ihren eigenen Sieger. Lässt sich auch während der Runde noch ändern." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vedlejší soutěže navíc k počtu ran – každá má svého vítěze. Dají se změnit i během kola."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nebenwertungen zusätzlich zur Schlagzahl – jede hat ihren eigenen Sieger. Lässt sich auch während der Runde noch ändern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Side contests on top of the stroke count – each one has its own winner. You can still change them during the round."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clasificaciones extra además del número de golpes: cada una tiene su ganador. Puedes cambiarlas durante la vuelta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Classements annexes en plus du nombre de coups – chacun a son vainqueur. Modifiable même en cours de partie."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Classifiche extra oltre al numero di colpi: ognuna ha il suo vincitore. Puoi modificarle anche durante il giro."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodatkowe klasyfikacje oprócz liczby uderzeń – każda ma własnego zwycięzcę. Można je zmienić także w trakcie rundy."
          }
        }
      }
    },
