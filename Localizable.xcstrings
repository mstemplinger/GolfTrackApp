            "state" : "translated",
            "value" : "That’s the only way the position of every stroke on the course is accurate."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo así la posición de cada golpe en el campo será correcta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "C’est la seule façon d’avoir la bonne position de chaque coup sur le parcours."
