    "Benachrichtigungen werden nur als lokale Erinnerungen verschickt – keine Werbung, keine Server." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oznámení se posílají jen jako místní připomínky – žádná reklama, žádné servery."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notifications are sent only as local reminders – no ads, no servers."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las notificaciones se envían solo como recordatorios locales: sin publicidad, sin servidores."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les notifications sont envoyées uniquement comme rappels locaux – pas de publicité, pas de serveur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le notifiche vengono inviate solo come promemoria locali – nessuna pubblicità, nessun server."
