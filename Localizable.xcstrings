    "Mit deiner Erlaubnis merkt sich GolfTrack deinen Weg über den Platz und erkennt daraus Abschlag, Grün und Fairway-Verlauf jedes Lochs." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S tvým svolením si GolfTrack pamatuje tvou cestu po hřišti a rozpozná z ní odpaliště, green a průběh fairwaye každé jamky."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "With your permission, GolfTrack remembers your path across the course and works out the tee, green and fairway of every hole."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con tu permiso, GolfTrack recuerda tu recorrido por el campo y detecta la salida, el green y la calle de cada hoyo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avec ton accord, GolfTrack mémorise ton chemin sur le parcours et en déduit le départ, le green et le tracé du fairway de chaque trou."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con il tuo permesso, GolfTrack memorizza il tuo percorso sul campo e ne ricava tee, green e andamento del fairway di ogni buca."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Za twoją zgodą GolfTrack zapamiętuje twoją drogę po polu i rozpoznaje na tej podstawie tee, green i przebieg fairwayu każdego dołka."
          }
        }
      }
    },
