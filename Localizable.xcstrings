    "Basierend auf Daten von über 100.000 Golfrunden analysiert Shot Scope die häufigsten Fehler von Handicap-Golfern." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na základě dat z více než 100 000 golfových kol analyzuje Shot Scope nejčastější chyby golfistů s handicapem."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Based on data from over 100,000 golf rounds, Shot Scope analyzes the most common mistakes of handicap golfers."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Basándose en datos de más de 100.000 vueltas de golf, Shot Scope analiza los errores más comunes de los golfistas con hándicap."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "À partir des données de plus de 100 000 parties de golf, Shot Scope analyse les erreurs les plus fréquentes des golfeurs à handicap."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Basandosi sui dati di oltre 100.000 giri di golf, Shot Scope analizza gli errori più comuni dei golfisti con handicap."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na podstawie danych z ponad 100 000 rund golfa Shot Scope analizuje najczęstsze błędy golfistów z handicapem."
          }
        }
      }
    },
