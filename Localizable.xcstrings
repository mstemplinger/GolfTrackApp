    "Ab etwa drei aufgezeichneten Runden pro Platz werden die Schätzungen deutlich stabiler." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zhruba od tří zaznamenaných kol na hřišti jsou odhady výrazně stabilnější."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "From about three recorded rounds per course the estimates become noticeably more stable."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A partir de unas tres vueltas grabadas por campo las estimaciones se vuelven claramente más estables."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "À partir d'environ trois parties enregistrées par parcours, les estimations deviennent nettement plus stables."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A partire da circa tre giri registrati per campo le stime diventano molto più stabili."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Od około trzech zapisanych rund na danym polu szacunki stają się wyraźnie stabilniejsze."
          }
        }
      }
    },
    "Ab jetzt zählen wir für dich mit – Loch für Loch." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Od teď počítáme za tebe – jamku po jamce."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "From now on we count for you – hole by hole."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A partir de ahora contamos por ti, hoyo a hoyo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "À partir de maintenant, nous comptons pour toi – trou par trou."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Da ora contiamo noi per te – buca dopo buca."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Od teraz liczymy za ciebie – dołek po dołku."
          }
        }
      }
    },
    "Ab zwei Einheiten mit diesem Schläger siehst du hier deine Entwicklung." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po dvou trénincích s touto holí tu uvidíš svůj vývoj."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "After two sessions with this club you will see your progress here."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A partir de dos sesiones con este palo verás aquí tu evolución."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dès deux séances avec ce club, tu verras ici ta progression."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dopo due sessioni con questa mazza vedrai qui i tuoi progressi."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po dwóch treningach tym kijem zobaczysz tu swoje postępy."
          }
        }
      }
    },
