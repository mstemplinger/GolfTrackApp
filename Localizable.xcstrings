    "Wenige Fairways getroffen. Mehr Stabilität im Stand sorgt für geradere Abschläge." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Málo trefených fairwayí. Větší stabilita v postoji zajistí rovnější odpaly."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenige Fairways getroffen. Mehr Stabilität im Stand sorgt für geradere Abschläge."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Few fairways hit. More stability in your stance leads to straighter tee shots."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pocos Fairways alcanzados. Más estabilidad en la postura da salidas más rectas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peu de fairways touchés. Plus de stabilité à l'adresse donne des drives plus droits."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pochi fairway centrati. Più stabilità nella posizione rende i colpi di partenza più dritti."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mało trafionych fairwayów. Większa stabilność postawy da prostsze uderzenia z tee."
          }
        }
      }
    },
    "Weniger anzeigen" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zobrazit méně"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Show less"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostrar menos"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afficher moins"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra meno"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokaż mniej"
          }
        }
      }
    },
    "Wenn du es erlaubst, merkt sich GolfTrack während der Runde alle paar Meter deine Position. Nach der Runde siehst du deinen Weg über den Platz auf der Karte." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Když to povolíš, GolfTrack si během kola každých pár metrů zapamatuje tvou polohu. Po kole uvidíš svou cestu po hřišti na mapě."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you allow it, GolfTrack notes your position every few metres during the round. Afterwards you can see your path across the course on the map."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si lo permites, GolfTrack anota tu posición cada pocos metros durante la vuelta. Después puedes ver tu recorrido por el campo en el mapa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si tu l'autorises, GolfTrack retient ta position tous les quelques mètres pendant la partie. Ensuite, tu vois ton parcours sur la carte."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se lo consenti, GolfTrack registra la tua posizione ogni pochi metri durante il giro. Dopo puoi vedere il tuo percorso sulla mappa."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeśli na to pozwolisz, GolfTrack co kilka metrów zapamiętuje twoją pozycję podczas rundy. Po rundzie zobaczysz swoją drogę po polu na mapie."
          }
        }
      }
    },
    "Wer braucht auf den letzten 3 Bahnen die wenigsten Schläge?" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kdo potřebuje na posledních 3 drahách nejméně ran?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wer braucht auf den letzten 3 Bahnen die wenigsten Schläge?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Who needs the fewest strokes on the last 3 holes?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Quién necesita menos golpes en las últimas 3 pistas?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qui a besoin du moins de coups sur les 3 dernières pistes ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chi impiega meno colpi nelle ultime 3 piste?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kto potrzebuje najmniej uderzeń na ostatnich 3 torach?"
          }
        }
      }
    },
    "Wer Doppelbogeys vermeidet, spielt die bessere Runde" : {

    },
    "Wer ein Training- oder Caddy-Abo hat, sieht ohnehin keine Werbung." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kdo má předplatné Training nebo Caddy, reklamy stejně nevidí."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "With a Training or Caddy subscription you won't see ads anyway."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con una suscripción Training o Caddy ya no ves anuncios."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avec un abonnement Training ou Caddy, vous ne voyez déjà aucune publicité."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con un abbonamento Training o Caddy non vedi comunque pubblicità."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kto ma subskrypcję Training lub Caddy, i tak nie widzi reklam."
          }
        }
      }
    },
    "Wer gewinnt die meisten Bahnen allein? Bei Gleichstand auf einer Bahn bekommt sie niemand." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kdo sám vyhraje nejvíc drah? Při remíze na dráze ji nedostane nikdo."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wer gewinnt die meisten Bahnen allein? Bei Gleichstand auf einer Bahn bekommt sie niemand."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Who wins the most holes outright? A tied hole goes to nobody."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Quién gana en solitario más pistas? Si hay empate en una pista, no la gana nadie."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qui gagne le plus de pistes en solo ? En cas d'égalité sur une piste, personne ne la remporte."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chi vince da solo il maggior numero di piste? In caso di parità su una pista non la vince nessuno."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kto samodzielnie wygra najwięcej torów? Przy remisie na torze nikt go nie dostaje."
          }
        }
      }
    },
