          }
        }
      }
    },
    "Die Hüfte dreht zuerst zum Ziel" : {

    },
    "Die klassische Spielform: Jeder Schlag zählt. Wer am Ende der Runde die wenigsten Schläge hat, gewinnt." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klasický formát: počítá se každá rána. Vyhrává ten, kdo má na konci kola nejméně ran."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The classic format: every stroke counts. Whoever has the fewest strokes at the end of the round wins."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La modalidad clásica: cuenta cada golpe. Gana quien tenga menos golpes al final de la vuelta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La formule classique : chaque coup compte. Celui qui a le moins de coups à la fin de la partie gagne."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La formula classica: conta ogni colpo. Vince chi alla fine del giro ha meno colpi."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klasyczny format: liczy się każde uderzenie. Wygrywa ten, kto na koniec rundy ma najmniej uderzeń."
          }
        }
      }
    },
