          }
        }
      }
    },
    "\n\nDas Positions-Tracking zeichnet dazwischen weiter deine Laufspur auf." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n\nSledování polohy mezitím dál zaznamenává tvou trasu."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n\nPosition tracking keeps recording your walking path in between."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n\nEl seguimiento de posición sigue registrando tu recorrido entre golpes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n\nLe suivi de position continue d’enregistrer ton parcours entre les coups."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n\nIl tracciamento della posizione continua a registrare il tuo percorso tra un colpo e l’altro."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n\nŚledzenie pozycji w międzyczasie nadal zapisuje twoją trasę."
          }
        }
      }
    },
    "\n\nMit eingeschaltetem Positions-Tracking lernt die App Abschläge und Grüns zusätzlich aus deiner Laufspur." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n\nSe zapnutým sledováním polohy se aplikace učí odpaliště a greeny také z tvé trasy."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n\nWith position tracking turned on, the app also learns tees and greens from your walking path."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n\nCon el seguimiento de posición activado, la app aprende además los tees y greens de tu recorrido."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n\nAvec le suivi de position activé, l’app apprend aussi les départs et les greens à partir de ton parcours."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n\nCon il tracciamento della posizione attivo, l’app impara anche tee e green dal tuo percorso."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n\nPo włączeniu śledzenia pozycji aplikacja uczy się tee i greenów także z twojej trasy."
          }
        }
      }
    },
