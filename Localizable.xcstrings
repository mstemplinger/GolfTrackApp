    "Nimm dein 7er-Eisen – damit schlägst du laut deinem Bag im Schnitt 140 m." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vezmi železo 7 – podle tvého bagu s ním hraješ v průměru 140 m."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Take your 7 iron – according to your bag you hit it 140 m on average."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coge tu hierro 7: según tu bolsa, con él golpeas 140 m de media."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prends ton fer 7 – d'après ton sac, tu le tapes en moyenne à 140 m."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prendi il ferro 7: secondo la tua sacca lo tiri in media a 140 m."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Weź żelazo 7 – według twojej torby uderzasz nim średnio 140 m."
          }
        }
      }
    },
