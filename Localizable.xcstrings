    "Loch für Loch gegen einen Gegner" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jamku po jamce proti jednomu soupeři"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hole by hole against one opponent"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoyo a hoyo contra un rival"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trou par trou contre un adversaire"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buca per buca contro un avversario"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dołek po dołku przeciwko jednemu rywalowi"
          }
        }
      }
    },
    "Loch für Loch. Wer das Loch mit weniger Schlägen spielt, gewinnt es. Wer am Ende mehr Löcher hat, gewinnt die Runde." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jamku po jamce. Kdo zahraje jamku na méně ran, vyhrává ji. Kdo má na konci víc vyhraných jamek, vyhrává kolo."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hole by hole. Whoever plays the hole in fewer strokes wins it. Whoever has won more holes at the end wins the round."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoyo a hoyo. Quien juegue el hoyo con menos golpes lo gana. Quien tenga más hoyos al final gana la vuelta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trou par trou. Celui qui joue le trou en moins de coups le gagne. Celui qui a le plus de trous à la fin gagne la partie."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buca per buca. Chi gioca la buca con meno colpi la vince. Chi alla fine ha più buche vince il giro."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dołek po dołku. Kto zagra dołek mniejszą liczbą uderzeń, wygrywa go. Kto na koniec ma więcej wygranych dołków, wygrywa rundę."
          }
        }
      }
    },
