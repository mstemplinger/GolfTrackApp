    "Zählen, messen, besser werden: In zwei Minuten zeigen wir dir, was GolfTrack auf und neben dem Platz für dich erledigt." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Počítat, měřit, zlepšovat se: za dvě minuty ti ukážeme, co pro tebe GolfTrack udělá na hřišti i mimo něj."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Score, measure, improve: in two minutes we'll show you what GolfTrack does for you on and off the course."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apuntar, medir, mejorar: en dos minutos te mostramos lo que GolfTrack hace por ti dentro y fuera del campo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compter, mesurer, progresser : en deux minutes, on te montre ce que GolfTrack fait pour toi sur le parcours et en dehors."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Segnare, misurare, migliorare: in due minuti ti mostriamo cosa fa GolfTrack per te dentro e fuori dal campo."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Licz, mierz, graj lepiej: w dwie minuty pokażemy ci, co GolfTrack robi dla ciebie na polu i poza nim."
          }
        }
      }
    },
