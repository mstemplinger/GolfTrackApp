    "iOS fragt gleich nach deiner Erlaubnis. Du kannst beides später in den Einstellungen ändern." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS se tě za chvíli zeptá na svolení. Obojí můžeš později změnit v Nastavení."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS will ask for your permission in a moment. You can change both later in Settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS te pedirá permiso en un momento. Puedes cambiar ambas cosas más tarde en Ajustes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS va te demander ton autorisation. Tu pourras modifier les deux plus tard dans les Réglages."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS ti chiederà a breve il permesso. Puoi modificare entrambe le cose in seguito nelle Impostazioni."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Za chwilę iOS poprosi o Twoją zgodę. Obie zgody możesz później zmienić w Ustawieniach."
          }
        }
      }
    },
    "iOS zeichnet auch bei gesperrtem Display weiter auf und zeigt dabei eine blaue Anzeige in der Statusleiste. Rechne mit etwas mehr Akkuverbrauch als ohne Tracking." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS zaznamenává i při zamčeném displeji a ukazuje přitom modrý indikátor ve stavovém řádku. Počítej s o něco vyšší spotřebou baterie než bez sledování."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS keeps recording while the display is locked and shows a blue indicator in the status bar. Expect somewhat higher battery use than without tracking."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS sigue grabando con la pantalla bloqueada y muestra un indicador azul en la barra de estado. Cuenta con algo más de consumo de batería que sin seguimiento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS continue d'enregistrer même écran verrouillé et affiche un indicateur bleu dans la barre d'état. Prévois une consommation de batterie un peu plus élevée que sans suivi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS continua a registrare anche con il display bloccato e mostra un indicatore blu nella barra di stato. Metti in conto un consumo di batteria un po' più alto rispetto a senza tracciamento."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS nagrywa także przy zablokowanym ekranie i pokazuje przy tym niebieski wskaźnik na pasku stanu. Licz się z nieco większym zużyciem baterii niż bez śledzenia."
          }
        }
      }
    },
