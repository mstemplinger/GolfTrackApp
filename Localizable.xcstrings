    "Halte die gedruckte Scorecard vor die Kamera – GolfTrack liest Par, HCP und Distanzen automatisch aus." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podrž vytištěnou scorekartu před fotoaparátem – GolfTrack automaticky načte par, HCP a vzdálenosti."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold the printed scorecard up to the camera – GolfTrack automatically reads par, HCP and distances."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coloca la tarjeta de puntuación impresa frente a la cámara: GolfTrack lee automáticamente el par, el HCP y las distancias."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Présente la carte de score imprimée devant la caméra – GolfTrack lit automatiquement le par, le HCP et les distances."
