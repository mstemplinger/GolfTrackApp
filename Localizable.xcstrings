    "Beide Partner schlagen ab. Der beste Abschlag wird gewählt. Danach spielen beide abwechselnd bis zum Einlochen." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oba partneři odpálí. Vybere se nejlepší drive. Pak oba hrají střídavě, dokud míček neskončí v jamce."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Both partners tee off. The best drive is chosen. From there they play alternate shots until the ball is holed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ambos compañeros salen. Se elige el mejor golpe de salida. Después juegan golpes alternos hasta embocar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les deux partenaires partent. Le meilleur coup de départ est choisi. Ensuite, ils jouent en coups alternés jusqu’à la mise en trou."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Battono entrambi i compagni. Si sceglie il colpo di partenza migliore. Poi giocano a colpi alterni fino a imbucare."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obaj partnerzy odbijają z tee. Wybiera się najlepszy drive. Potem obaj grają na zmianę aż do wbicia piłki do dołka."
          }
        }
      }
    },
    "Beide schlagen ab – bester Abschlag wird gespielt" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
