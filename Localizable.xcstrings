    "Scanne deine Mitgliedskarte oder Greenfee-Belege für schnellen Zugriff." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naskenuj si členskou kartu nebo účtenky za greenfee pro rychlý přístup."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scanne deine Mitgliedskarte oder Greenfee-Belege für schnellen Zugriff."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scan your membership card or greenfee receipts for quick access."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escanea tu tarjeta de socio o los recibos de green fee para un acceso rápido."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scanne ta carte de membre ou tes reçus de green fee pour un accès rapide."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scansiona la tua tessera o le ricevute green fee per un accesso rapido."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeskanuj kartę członkowską lub paragony za greenfee, aby mieć do nich szybki dostęp."
          }
        }
      }
    },
    "Schätzt aus den Messpunkten zwischen Abschlag und Grün, wo das Fairway ungefähr verläuft. Braucht gespeicherte Loch-Positionen." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Z měřicích bodů mezi odpalištěm a greenem odhaduje, kudy zhruba vede fairway. Vyžaduje uložené polohy jamek."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estimates roughly where the fairway runs, from the measurements between tee and green. Requires saved hole positions."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estima aproximadamente por dónde va el fairway a partir de las mediciones entre el tee y el green. Requiere posiciones de hoyo guardadas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estime approximativement le tracé du fairway à partir des mesures entre le départ et le green. Nécessite des positions de trous enregistrées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stima approssimativamente dove passa il fairway partendo dalle misurazioni tra tee e green. Richiede posizioni delle buche salvate."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na podstawie punktów pomiarowych między tee a greenem szacuje, gdzie mniej więcej biegnie fairway. Wymaga zapisanych pozycji dołków."
          }
        }
      }
    },
    "Schau im App Store nach Updates – mit jedem Update kommen neue Lektionen dazu, die im Abo und im Einmalkauf inklusive sind." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sleduj aktualizace v App Store – s každou přibývají nové lekce, které jsou v předplatném i jednorázovém nákupu v ceně."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Check the App Store for updates – each update adds new lessons that are included in the subscription and the one-time purchase."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Busca actualizaciones en la App Store: cada actualización añade nuevas lecciones incluidas en la suscripción y en la compra única."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vérifie les mises à jour dans l'App Store – chaque mise à jour ajoute de nouvelles leçons incluses dans l'abonnement et l'achat unique."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controlla gli aggiornamenti nell'App Store – ogni aggiornamento aggiunge nuove lezioni incluse nell'abbonamento e nell'acquisto unico."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sprawdzaj aktualizacje w App Store – z każdą aktualizacją dochodzą nowe lekcje, zawarte w subskrypcji i w zakupie jednorazowym."
          }
        }
      }
    },
    "Schau mal, ich habe gerade %@ gebraucht!" : {
