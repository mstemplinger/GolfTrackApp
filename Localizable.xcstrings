    "Etwas enger, Ball in der Mitte" : {

    },
    "Etwas zu viele Putts. Besseres Grünlesen kann direkt Schläge sparen." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trochu moc patů. Lepší čtení greenu ušetří rány hned."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etwas zu viele Putts. Besseres Grünlesen kann direkt Schläge sparen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slightly too many putts. Reading greens better saves strokes right away."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Algo demasiados putts. Leer mejor el green ahorra golpes de inmediato."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un peu trop de putts. Mieux lire le green fait gagner des coups tout de suite."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qualche putt di troppo. Leggere meglio il green fa risparmiare colpi subito."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trochę za dużo puttów. Lepsze czytanie greenu od razu oszczędza uderzenia."
          }
        }
      }
    },
    "Fahne per Tipp" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vlajka jedním klepnutím"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flag with one tap"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bandera con un toque"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drapeau en un geste"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bandiera con un tocco"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flaga jednym dotknięciem"
          }
        }
      }
    },
    "Fahne setzen, Schläge aufzeichnen: Jede Weite landet bei deinem Schläger. So werden die Empfehlungen mit jeder Runde genauer." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nastav vlajku, zaznamenávej rány: každá vzdálenost se připíše holi, kterou jsi hrál. Doporučení jsou tak s každým kolem přesnější."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Set the flag, record your shots: every distance is credited to the club you used, so the recommendations get more precise with every round."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coloca la bandera y registra tus golpes: cada distancia se asigna a tu palo, así las recomendaciones mejoran con cada vuelta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Place le drapeau, enregistre tes coups : chaque distance est attribuée à ton club, et les recommandations s'affinent à chaque partie."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Posiziona la bandiera, registra i colpi: ogni distanza va alla tua mazza, così i consigli diventano più precisi a ogni giro."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ustaw flagę, zapisuj uderzenia: każda odległość trafia do kija, którym grałeś. Dzięki temu zalecenia są z każdą rundą dokładniejsze."
          }
        }
      }
    },
