    "Schläge, Putts, Fairway und Grün in Regulation pro Loch. Die Entfernung zur Fahne und der passende Schläger stehen direkt darüber." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rány, paty, fairway a green v regulaci na každé jamce. Vzdálenost k vlajce a vhodná hůl jsou hned nad tím."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Strokes, putts, fairway and green in regulation for every hole. The distance to the flag and the right club are shown right above."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Golpes, putts, calle y green en regulación por hoyo. La distancia a la bandera y el palo adecuado aparecen justo encima."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coups, putts, fairway et green en régulation pour chaque trou. La distance au drapeau et le bon club s'affichent juste au-dessus."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Colpi, putt, fairway e green in regulation per ogni buca. La distanza dalla bandiera e la mazza giusta sono subito sopra."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uderzenia, putty, fairway i green w regulaminowej liczbie uderzeń na każdym dołku. Odległość do flagi i odpowiedni kij są wyświetlane tuż nad nimi."
          }
        }
      }
    },
