    "Punkte statt Schläge – Birdie=3, Par=2, Bogey=1" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Body místo ran – birdie=3, par=2, bogey=1"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Points instead of strokes – birdie=3, par=2, bogey=1"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puntos en vez de golpes: birdie=3, par=2, bogey=1"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Des points au lieu des coups – birdie=3, par=2, bogey=1"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Punti invece di colpi – birdie=3, par=2, bogey=1"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Punkty zamiast uderzeń – birdie=3, par=2, bogey=1"
          }
        }
      }
    },
    "Punkte statt Schläge: Albatross=5, Eagle=4, Birdie=3, Par=2, Bogey=1, Double+=0. Wer die meisten Punkte sammelt, gewinnt." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Body místo ran: albatros=5, eagle=4, birdie=3, par=2, bogey=1, double+=0. Vyhrává ten, kdo nasbírá nejvíc bodů."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Points instead of strokes: albatross=5, eagle=4, birdie=3, par=2, bogey=1, double+=0. Whoever collects the most points wins."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puntos en vez de golpes: albatros=5, eagle=4, birdie=3, par=2, bogey=1, doble+=0. Gana quien más puntos sume."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Des points au lieu des coups : albatros=5, eagle=4, birdie=3, par=2, bogey=1, double+=0. Celui qui récolte le plus de points gagne."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Punti invece di colpi: albatros=5, eagle=4, birdie=3, par=2, bogey=1, doppio+=0. Vince chi raccoglie più punti."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Punkty zamiast uderzeń: albatros=5, eagle=4, birdie=3, par=2, bogey=1, double+=0. Wygrywa ten, kto zbierze najwięcej punktów."
          }
        }
      }
    },
