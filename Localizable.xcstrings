    },
    "Vor Ort einfach den QR-Code scannen – Begrüßung, kurze Einführung, los." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na místě prostě naskenuj QR kód – přivítání, krátký úvod a jde se na to."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On site simply scan the QR code – greeting, short intro, off you go."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En el lugar solo hay que escanear el código QR: bienvenida, breve introducción y a jugar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sur place, scanne simplement le code QR : accueil, courte intro, c'est parti."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sul posto basta scansionare il codice QR: benvenuto, breve introduzione e via."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na miejscu po prostu zeskanuj kod QR – powitanie, krótkie wprowadzenie i gotowe."
