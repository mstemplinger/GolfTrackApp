    "Wie Zählspiel, aber die schlechteste(n) Löcher werden gestrichen. Bei 18 Löchern werden 2 Streichlöcher angerechnet, bei 9 Löchern 1." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jako hra na rány, ale nejhorší jamky se škrtají. Při 18 jamkách se škrtají 2, při 9 jamkách 1."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Like stroke play, but the worst holes are dropped. Over 18 holes two holes are dropped, over 9 holes one."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Como el juego por golpes, pero se descartan los peores hoyos. En 18 hoyos se descartan 2 y en 9 hoyos, 1."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comme le stroke play, mais les plus mauvais trous sont retirés. Sur 18 trous, 2 trous sont retirés ; sur 9 trous, 1."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Come la gara a colpi, ma si scartano le buche peggiori. Su 18 buche se ne scartano 2, su 9 buche 1."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jak stroke play, ale najgorsze dołki są skreślane. Przy 18 dołkach skreśla się 2, przy 9 dołkach 1."
          }
        }
      }
    },
