    "Danach %@ / %@, jederzeit kündbar." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poté %1$@ / %2$@, kdykoli zrušitelné."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Danach %1$@ / %2$@, jederzeit kündbar."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Then %1$@ / %2$@, cancel anytime."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Después %1$@ / %2$@, cancela cuando quieras."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ensuite %1$@ / %2$@, résiliable à tout moment."
          }
        },
        "it" : {
