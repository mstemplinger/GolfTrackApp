    "GolfTrack kann jetzt aufzeichnen, wo du auf dem Platz unterwegs warst – und daraus lernen, wie die Löcher liegen." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GolfTrack teď umí zaznamenat, kudy ses po hřišti pohyboval – a naučit se z toho, jak jamky leží."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GolfTrack can now record where you walked on the course – and learn from it how the holes are laid out."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GolfTrack ahora puede grabar por dónde has ido en el campo y deducir de ello cómo están dispuestos los hoyos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GolfTrack peut désormais enregistrer où tu es passé sur le parcours et en déduire la disposition des trous."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GolfTrack ora può registrare dove ti sei mosso sul campo e capirne la disposizione delle buche."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GolfTrack może teraz zapisywać, gdzie poruszałeś się po polu – i uczyć się z tego, jak położone są dołki."
          }
        }
      }
    },
