    "Du brauchst noch viele Putts. Diese Lektion trainiert deine Distanzkontrolle auf dem Grün." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pořád potřebuješ hodně patů. Tato lekce trénuje kontrolu délky na greenu."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du brauchst noch viele Putts. Diese Lektion trainiert deine Distanzkontrolle auf dem Grün."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You still need a lot of putts. This lesson trains your distance control on the green."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aún necesitas muchos putts. Esta lección entrena tu control de distancia en el green."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu as encore besoin de beaucoup de putts. Cette leçon travaille ton contrôle de distance sur le green."
          }
        },
        "it" : {
          "stringUnit" : {
