    "Oben rechts siehst du jederzeit die Tabelle. Nach der letzten Bahn steht der Sieger fest." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vpravo nahoře kdykoli vidíš tabulku. Po poslední dráze je vítěz jasný."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The standings are available at the top right at any time. After the last hole the winner is decided."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arriba a la derecha ves la clasificación en cualquier momento. Tras la última pista se decide el ganador."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En haut à droite, le classement est visible à tout moment. Après la dernière piste, le vainqueur est désigné."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In alto a destra vedi sempre la classifica. Dopo l'ultima pista è deciso il vincitore."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "W prawym górnym rogu w każdej chwili widzisz tabelę. Po ostatnim torze zwycięzca jest znany."
          }
        }
      }
    },
